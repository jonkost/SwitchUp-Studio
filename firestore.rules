rules_version = '2';

// SwitchUp Studio Firestore rules.
//
// READ THIS BEFORE TRUSTING THESE RULES.
// This app ships with NO Firebase Authentication — the client never signs in,
// so `request.auth` is always null and rules cannot tell a real app user apart
// from an attacker running curl/Burp/a script. What the rules below provide is
// SHAPE HARDENING: each document is pinned to a known set of fields and sizes,
// and writes to unknown collections are denied. That stops junk/oversized
// writes and accidental collection creation. It does NOT provide confidentiality
// or real access control — anyone who knows the project id can still read
// content/submissions and forge an admin record.
//
// The real protection for an app with no user accounts is Firebase App Check
// (enable it and ENFORCE it on Firestore in the console — it needs no logins).
// To gate admin writes properly, add Firebase Auth and check request.auth.uid.
//
// NOTE: validate these in the Rules Playground / emulator before publishing.

service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // Dashboard-authored content, keyed by refId.
    // Written via saveContentItem(): { refId, text, type, group, section, updatedAt }.
    function validContent() {
      return request.resource.data.keys().hasOnly(
               ['refId', 'text', 'type', 'group', 'section', 'updatedAt'])
        && str(request.resource.data.refId, 200)
        && str(request.resource.data.get('text', ''), 50000)
        && str(request.resource.data.get('type', ''), 100)
        && str(request.resource.data.get('group', ''), 100)
        && str(request.resource.data.get('section', ''), 300);
    }

    match /content_lessons/{docId} {
      allow read: if true;
      allow write: if validContent();
    }
    match /content_quiz_bank/{docId} {
      allow read: if true;
      allow write: if validContent();
    }
    match /content_run_the_show/{docId} {
      allow read: if true;
      allow write: if validContent();
    }

    // Narration metadata (audio is generated by an Admin-SDK script, which
    // bypasses these rules). Cap field count to block blob abuse from clients.
    match /narration/{docId} {
      allow read: if true;
      allow write: if request.resource.data.size() <= 30;
    }

    // Admin roster. Still publicly writable because there is no auth to gate on;
    // the field whitelist only stops arbitrary junk. REAL FIX: Firebase Auth +
    // gate writes on request.auth and a super-admin check.
    match /admins/{uid} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(
                        ['id', 'uid', 'name', 'email', 'displayName', 'codeHash',
                         'level', 'role', 'createdBy', 'createdAt', 'updatedAt'])
                     && str(request.resource.data.get('name', ''), 120)
                     && str(request.resource.data.get('codeHash', ''), 80)
                     && (request.resource.data.get('level', 'standard')
                          in ['standard', 'full', 'super']);
      allow delete: if true;
    }

    // Student submissions: create-only, never editable or deletable (integrity).
    // The payload is open-ended (`...summary`), so we only assert the marker field.
    match /quiz_submissions/{docId} {
      allow create: if request.resource.data.result_type == 'quiz';
      allow read: if true;
      allow update, delete: if false;
    }
    match /lesson_submissions/{docId} {
      allow create: if request.resource.data.result_type == 'lesson';
      allow read: if true;
      allow update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
