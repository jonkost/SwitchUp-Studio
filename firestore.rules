rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /content_lessons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_quiz_bank/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_run_the_show/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /narration/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
